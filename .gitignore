# Only backend and web-app are managed at repository root.
/*
!/.gitignore
!/backend/
!/backend/**
!/web-app/
!/web-app/**
# Phát hành: chạy cả hệ thống bằng một lệnh + tài liệu
!/README.md
!/docker-compose.yml
!/.env.example
!/api-collection/
!/api-collection/**
!/docs/
/docs/*
!/docs/events.md
!/docs/demo-script.md

# Generated files and local tooling data.
**/target/
**/hs_err_pid*.log
**/replay_pid*.log
**/node_modules/
**/.idea/
**/*.iml
**/.classpath
**/.project
**/.settings/

# Local environment and secret files.
**/.env
**/.env.*
!**/.env.example

# OS/editor files.
.DS_Store
Thumbs.db

