# Sao chép thành .env (file .env không được commit):  cp .env.example .env
# Đổi các giá trị bí mật trước khi chạy ở môi trường không phải máy cá nhân.

# Mật khẩu Postgres dùng chung cho các database của dev
DB_PASSWORD=123456

# API Gateway gắn secret này vào mọi request; service phía sau từ chối request thiếu/sai secret
GATEWAY_SECRET=change-me-gateway-secret

# payment-service gọi /api/internal của booking-service bằng key này
BOOKING_SERVICE_KEY=change-me-booking-service-key

# Dữ liệu mẫu: tài khoản demo/admin + suất chiếu 7 ngày tới
DEMO_SEED=true
AUTH_DEMO_PASSWORD=Demo@123
AUTH_ADMIN_PASSWORD=Admin@123

# Upload ảnh/video phim trong trang admin (tuỳ chọn; để trống thì chỉ tính năng upload bị tắt)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
